# Copy to .env.local, or supply these variables in your build environment.
# Public Clerk key; never use CLERK_SECRET_KEY or provider credentials here.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_AUTH_BYPASS=false
VITE_HOME_WORKFLOW=api
# Vite development server only. Production must reverse-proxy /api to Go.
DEV_API_PROXY_TARGET=http://localhost:8080

# Optional .env.development.local overrides for local UI work:
# VITE_AUTH_BYPASS=true
# VITE_HOME_WORKFLOW=demo
# Bypass is rejected by every build and preview, including custom build modes.
