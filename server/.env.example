DATABASE_URL=postgres://studio:studio@127.0.0.1:5433/studio?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Optional: jobs each queue runs at once in this process (defaults shown).
# QUEUE_LLM_WORKERS=10
# QUEUE_IMAGE_WORKERS=4
# QUEUE_VIDEO_WORKERS=3
# QUEUE_RENDER_WORKERS=2
# Optional: where media files are stored (default data/blobs, relative to the working directory).
# BLOB_DIR=data/blobs
# Optional override of the bundled 2-second H.264 demo clip.
# Relative to the server working directory.
FAKE_VIDEO_SAMPLE=testdata/fake-video.mp4

# Optional account authentication. Set all three together to enable /api/v1/me.
# Clerk secret keys belong only on the backend.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Private media download signing. Use a random secret, at least 32 bytes.
# Generate with: openssl rand -hex 32
# MEDIA_SIGNING_KEY=...

# Real image generation (fake by default). Keys belong only on the server.
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
